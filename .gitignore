# Dependencies
node_modules/

# Build output (scripts/package-classic.sh)
dist/

# Coverage (scripts/collect-coverage.js, used by npm run fallow:gate)
coverage/

# Tool caches
.cache/
__pycache__/
*.py[cod]

# Fallow review app session files (local reviewer feed + cursor)
.fallow-review/

# Signing material — never commit
*.p12
*.pfx

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors — keep shared workspace settings (enables .github/hooks)
.idea/
.vscode/*
!.vscode/settings.json
